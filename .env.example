# ===========================================
# Hephaistos2-Kit — variables d'environnement
# ===========================================
# TEMPLATE D'INJECTION — copie dans chaque workspace.
# Placeholders — renseigner ou laisser HKCU faire foi.
# JAMAIS de valeurs reelles dans un .env.example.

# === MÉMOIRE GLOBALE & STOCKAGE (mode dual) ===
# Racine du stockage memoire partage (KG, caches, rapports)
AGENT_DB_ROOT=
# DB SQLite du memory MCP (graph)
MEMORY_FILE_PATH=
# Donnees Zvec (vector store)
ZVEC_DATA_DIR=
# Stockage Qdrant local
QDRANT_STORAGE_DIR=
# DB sqlite-node (nodes.db)
SQLITE_NODE_DB_PATH=
# Modele d'embeddings (2048D attendu par les collections)
EMBEDDING_MODEL=

# === PROVIDERS LLM — CLÉS API ===
# NVIDIA NIM principal
NVIDIA_API_KEY=
# NVIDIA NIM secondaire (nim2)
NVIDIA_API_KEY_2=
# Reroutee vers NVIDIA (meme jeton nvapi)
OPENAI_API_KEY=
# Mistral
MISTRAL_API_KEY=
# Mistral Vibe
MISTRAL_VIBE_API_KEY=
# Base URL Mistral
MISTRAL_API_BASE=
# OpenRouter
OPENROUTER_API_KEY=
# Google Gemini
GEMINI_API_KEY=
# Groq
GROQ_API_KEY=
# Anthropic (vide = relay Ollama local)
# ANTHROPIC_API_KEY=   # vide dans HKCU
# Auth Anthropic alternatif
# ANTHROPIC_AUTH_TOKEN=   # vide dans HKCU
# Relay Anthropic -> Ollama local
ANTHROPIC_BASE_URL=
# Provider custom LiteLLM
CUSTOM_API_KEY=
# Hyper3D/Rodin
HYPER3D_API_KEY=
# Exa search
EXA_API_KEY=
# Context7 docs
CONTEXT7_API_KEY=
# Brave search
BRAVE_API_KEY_OVERRIDE=
# MalwareBazaar
MALWAREBAZAAR_API_KEY=
# Qdrant cloud
QDRANT_API_KEY=
# Hugging Face
HF_TOKEN=
# Kaggle user
KAGGLE_USERNAME=
# Kaggle legacy key
KAGGLE_KEY=
# Kaggle API token
KAGGLE_API_TOKEN=
# Supabase management
SUPABASE_ACCESS_TOKEN=
# PostgreSQL local
POSTGRES_PASSWORD=

# === GITHUB & OUTILS DEV ===
# GitHub PAT (gh, API, MCP github)
GITHUB_TOKEN=

# === OBSIDIAN ===
# Local REST API plugin (port 27124 https)
OBSIDIAN_API_KEY=
# Chemin du vault principal
OBSIDIAN_VAULT_PATH=

# === N8N ===
# Cle API n8n (JWT)
N8N_API_KEY=
# Cle MCP n8n (JWT)
N8N_MCP_API_KEY=
# URL API n8n
N8N_API_URL=
# URL editeur n8n
N8N_EDITOR_BASE_URL=
# URL publique n8n
N8N_PUBLIC_URL=
# Bind host
N8N_HOST=
# Bind address
N8N_LISTEN_ADDRESS=
# Port
N8N_PORT=
# Protocole
N8N_PROTOCOL=
# API publique on
N8N_PUBLIC_API_ENABLED=
# API publique off flag
N8N_PUBLIC_API_DISABLED=
# Prefixe endpoint
N8N_PUBLIC_API_ENDPOINT=
# URL webhooks
WEBHOOK_URL=

# === TELEGRAM & TWITTER ===
# Telegram app id
TELEGRAM_API_ID=
# Telegram app hash
TELEGRAM_API_HASH=
# Titre app Telegram
TELEGRAM_APP_TITLE=
# Bot token
TELEGRAM_BOT_TOKEN=
# Chat cible
TELEGRAM_CHAT_ID=
# X/Twitter auth_token cookie
TWITTER_AUTH_TOKEN=
# X/Twitter ct0 cookie
TWITTER_CT0=

# === OLLAMA & GPU LOCAL ===
# Endpoint daemon Ollama
OLLAMA_HOST=
# Racine Ollama
OLLAMA_HOME=
# Dossier modeles
OLLAMA_MODELS=
# Activation GPU
OLLAMA_GPU=
# Nb modeles charges
OLLAMA_MAX_LOADED_MODELS=
# TTL modeles charges
OLLAMA_KEEP_ALIVE=
# Fenetre contexte
OLLAMA_CONTEXT_LENGTH=
# Flash attention
OLLAMA_FLASH_ATTENTION=
# GPU visible
CUDA_VISIBLE_DEVICES=
# Alloc config CUDA
PYTORCH_CUDA_ALLOC_CONF=

# === CLOUDFLARE & TUNNELS ===
# Token DNS Cloudflare
CLOUDFLARE_DNS_TOKEN=
# Account ID Cloudflare
CLOUDFLARE_ACCOUNT_ID=
# Tunnel marotte (JWT)
MAROTTE_TUNNEL_TOKEN=

# === AGENTS & RUNTIME DIVERS ===
# Token generique
AUTH_TOKEN=
# Agent par defaut du gateway MCP
GATEWAY_DEFAULT_AGENT=
# FreeToken bin
FREETOKEN_FT_BIN=
# Racine Hermes
HERMES_HOME=
# bash.exe pour Hermes
HERMES_GIT_BASH_PATH=
# Espace temporaire projets
TEMP_PATH=
